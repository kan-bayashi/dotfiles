#!/bin/sh

# Refresh the stable agent socket on every connection so herdr --remote bridge
# sessions use the latest forwarded SSH agent socket.
if [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "$SSH_AUTH_SOCK" ]; then
    ln -snf "$SSH_AUTH_SOCK" "$HOME/.ssh/sock"
fi

# Preserve sshd's default X11 cookie setup, which ~/.ssh/rc replaces.
if read -r proto cookie && [ -n "${DISPLAY:-}" ]; then
    if [ "$(echo "$DISPLAY" | cut -c1-10)" = "localhost:" ]; then
        echo add "unix:$(echo "$DISPLAY" | cut -c11-)" "$proto" "$cookie"
    else
        echo add "$DISPLAY" "$proto" "$cookie"
    fi | xauth -q -
fi
